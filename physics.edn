;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:dev:physics` runs it.
;;
;; README "Robotics premise": a waste-collection robot performs route pickup,
;; bin handling and preliminary sort (COFOG 05.1 waste management). Its
;; physical work is tipping wheeled bins with a lift arm and shuttling the
;; collected load from the kerbside to the collection vehicle.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-cofog-05.1"
 :cases
 [{:id :wheelie-bin-lift
   :kind :manipulator
   :procedure "lift arm grips a 240 L wheeled bin at kerb height and raises it over the hopper lip to tip it"
   :params {:l1-m 1.00 :l2-m 0.90 :m1-kg 25.0 :m2-kg 18.0
            :from [1.20 0.10] :to [0.40 1.50] :duration-s 4.0 :steps 400}
   :sweep {:param :payload-kg :values [15.0 30.0 50.0 75.0 100.0]}
   :quantity :peak-tau1-nm
   :limit {:max 1500.0 :basis "estimate: continuous shoulder torque of an electro-hydraulic bin-lifter arm in this size class"}
   :boundary {:lo 5.0 :hi 400.0}}
  {:id :kerb-to-truck-shuttle
   :kind :transport
   :procedure "sorting robot shuttles collected bags 40 m from the kerbside cluster to the collection vehicle"
   :params {:mass-kg 150.0 :distance-m 40.0 :v-max-mps 1.2 :a-max-mps2 0.6
            :brake-decel-mps2 1.0 :drive-force-n 400.0 :crr 0.02
            :cog-height-m 0.60 :support-half-length-m 0.40}
   :sweep {:param :payload-kg :values [50.0 200.0 350.0 500.0 700.0]}
   :quantity :cycle-time-s
   :limit {:max 45.0 :basis "estimate: one shuttle leg must fit the collection vehicle's roughly one-minute stop per kerbside cluster"}
   :boundary {:lo 10.0 :hi 2000.0}}]}
